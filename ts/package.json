{
  "name": "@voxgig-sdk/resend-sdk",
  "version": "0.0.1",
  "description": "Unofficial generated TypeScript SDK for the Resend public API. Not affiliated with or endorsed by the upstream API provider.",
  "keywords": [
    "voxgig",
    "sdk",
    "generated-sdk",
    "openapi",
    "api-client",
    "resend"
  ],
  "homepage": "https://github.com/voxgig-sdk/resend-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxgig-sdk/resend-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/voxgig-sdk/resend-sdk/issues"
  },
  "main": "dist/ResendSDK.js",
  "type": "commonjs",
  "types": "dist/ResendSDK.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "node --enable-source-maps --test-concurrency=1 --test dist-test/**/*.test.js",
"test-some": "node --enable-source-maps --experimental-test-isolation=none --test-name-pattern=\"$TEST_PATTERN\" --test dist-test/**/*.test.js",
"test-coverage": "node --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=**/dist-test/** --test-coverage-lines=85 --test-coverage-branches=68 --test-coverage-functions=88 --test dist-test/**/*.test.js",
    "pretest-coverage": "npm run build",
    "test-coverage": "node --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude='**/dist-test/**' --test-coverage-lines=85 --test-coverage-branches=68 --test-coverage-functions=88 --test 'dist-test/**/*.test.js'",
    "watch": "tsc --build src test -w",
    "build": "rimraf dist dist-test && tsc --build src test",
    "clean": "rimraf node_modules dist dist-test",
    "reset": "npm run clean && npm i && npm run build && npm test"
  },
  "author": {
    "name": "Voxgig",
    "url": "https://voxgig.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
